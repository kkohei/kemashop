# ===== サーバー設定 =====
PORT=8080

# ===== Bカート Webhook 検証 =====
# Bカートの Webhook 登録時に設定する署名シークレット(Bcart-Signature の検証に使用)
BCART_WEBHOOK_SIGNING_SECRET=
# フォールバックの共有シークレット(?token= / X-Relay-Token)。署名を使うなら空でも可
WEBHOOK_SHARED_SECRET=change-me-to-a-long-random-string
# 検証失敗を拒否するか。初回キャプチャ時は false、仕様確定後 true 推奨
WEBHOOK_VERIFY_STRICT=false
# 受信した生ペイロードを data/webhook-capture.log に保存(フェーズ0の調査用)
WEBHOOK_CAPTURE=true

# ===== 管理画面(一斉配信) =====
# /admin にログインするためのパスワード(長いランダム文字列を推奨)
ADMIN_SECRET=

# ===== APNs(Apple Push Notification service)設定 =====
# Apple Developer で発行した .p8 認証キーのファイルパス
APNS_KEY_PATH=./secrets/AuthKey_XXXXXXXXXX.p8
# .p8 キーの Key ID(10文字)
APNS_KEY_ID=XXXXXXXXXX
# Apple Developer の Team ID(10文字)
APNS_TEAM_ID=YYYYYYYYYY
# iOSアプリの Bundle ID(例: jp.kemashop.bcart)
APNS_BUNDLE_ID=jp.example.bcart
# 本番APNsなら true、開発(Xcodeデバッグビルド)なら false
APNS_PRODUCTION=false

# ===== Bカート API 設定(受注詳細の取得用) =====
# パーソナルアクセストークン(Bearer)
BCART_API_TOKEN=
# BカートAPIのベースURL(契約に応じて設定)
BCART_API_BASE=https://api.bcart.jp

# ===== FCM(Androidプッシュ)設定 =====
# Firebaseコンソール > プロジェクト設定 > サービスアカウント で発行した鍵JSONのパス
FCM_SERVICE_ACCOUNT_PATH=./secrets/fcm-service-account.json
