# ===== サーバー設定 =====
PORT=8080

# ===== Bカート Webhook 検証 =====
# Bカートの Webhook 登録時に設定する署名シークレット(Bcart-Signature の検証に使用)
BCART_WEBHOOK_SIGNING_SECRET=
# フォールバックの共有シークレット(?token= / X-Relay-Token)。署名を使うなら空でも可
WEBHOOK_SHARED_SECRET=change-me-to-a-long-random-string
# 検証失敗を拒否するか。既定は true(未設定でも true)。文字列 "false" のときだけ緩和される。
# 署名シークレットも共有シークレットも未設定なら、strict では全Webhookを 401 で拒否する(fail closed)。
WEBHOOK_VERIFY_STRICT=true
# Bcart-Signature の date が現在時刻から何秒以内か(既定 300 = ±5分)。0 で無効。
# date がタイムゾーン無しの文字列でサーバーTZとずれて弾かれる場合のみ 0 を検討。
# WEBHOOK_MAX_AGE_SEC=300
# 受信した生ペイロードを data/webhook-capture.log に保存(調査用。顧客情報を含むため既定 false)
WEBHOOK_CAPTURE=false
# キャプチャログの最大バイト数。超えると .1 へローテーションし古い方は破棄(既定 1MB)
# WEBHOOK_CAPTURE_MAX_BYTES=1048576

# ===== 端末登録(/devices/register, /devices/unregister)の認証: 段階移行 =====
# 新方式: ヘッダー X-App-Token がこの値と一致すれば認証済み(更新版アプリが送る予定)。長いランダム文字列を設定。
APP_REGISTER_SECRET=
# 旧アプリ(App Store v1.0 / 現行Android。トークンを送らない)の登録を許可するか。既定 true。
# ★本番手順: 更新版アプリが十分に行き渡るまで true のまま運用 → 配布後に false へ変更して pm2 restart。
#   false にすると X-App-Token 無し/不一致の登録は 401 になり、旧アプリは登録できなくなる。
#   true の間は、レガシー受付のたびに警告ログが出る(トークン値は出力しない)。
ALLOW_LEGACY_DEVICE_REGISTER=true

# ===== その他 =====
# processed_events(Webhook冪等テーブル)の保持日数。起動時と6時間ごとに古い行を削除(既定 30)
# PROCESSED_EVENTS_RETENTION_DAYS=30
# nginx等のリバースプロキシ段数(レート制限のクライアントIP判定)。既定 1。直接公開なら false
# TRUST_PROXY=1
# DBファイルのパス(既定 data/relay.sqlite)。テストでは :memory: を指定
# RELAY_DB_PATH=

# ===== 管理画面(一斉配信) =====
# /admin にログインするためのパスワード(長いランダム文字列を推奨)
ADMIN_SECRET=

# ===== APNs(Apple Push Notification service)設定 =====
# Apple Developer で発行した .p8 認証キーのファイルパス
APNS_KEY_PATH=./secrets/AuthKey_XXXXXXXXXX.p8
# .p8 キーの Key ID(10文字)
APNS_KEY_ID=XXXXXXXXXX
# Apple Developer の Team ID(10文字)
APNS_TEAM_ID=YYYYYYYYYY
# iOSアプリの Bundle ID(例: jp.kemashop.bcart)
APNS_BUNDLE_ID=jp.example.bcart
# 本番APNsなら true、開発(Xcodeデバッグビルド)なら false
APNS_PRODUCTION=false

# ===== Bカート API 設定(受注詳細の取得用) =====
# パーソナルアクセストークン(Bearer)
BCART_API_TOKEN=
# BカートAPIのベースURL(契約に応じて設定)
BCART_API_BASE=https://api.bcart.jp

# ===== FCM(Androidプッシュ)設定 =====
# Firebaseコンソール > プロジェクト設定 > サービスアカウント で発行した鍵JSONのパス
FCM_SERVICE_ACCOUNT_PATH=./secrets/fcm-service-account.json
