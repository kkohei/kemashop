# ===== サーバー設定 =====
PORT=8080

# Bカート Webhook を受け付ける際の共有シークレット
# (Webhook登録URLに ?token=xxxx を付けるか、ヘッダー X-Relay-Token で送る)
# 任意の長いランダム文字列を設定してください
WEBHOOK_SHARED_SECRET=change-me-to-a-long-random-string

# ===== APNs(Apple Push Notification service)設定 =====
# Apple Developer で発行した .p8 認証キーのファイルパス
APNS_KEY_PATH=./secrets/AuthKey_XXXXXXXXXX.p8
# .p8 キーの Key ID(10文字)
APNS_KEY_ID=XXXXXXXXXX
# Apple Developer の Team ID(10文字)
APNS_TEAM_ID=YYYYYYYYYY
# iOSアプリの Bundle ID(例: jp.kemashop.bcart)
APNS_BUNDLE_ID=jp.example.bcart
# 本番APNsなら true、開発(Xcodeデバッグビルド)なら false
APNS_PRODUCTION=false

# ===== Bカート API 設定(詳細取得・ポーリング用 / 任意) =====
# パーソナルアクセストークン(Bearer)
BCART_API_TOKEN=
# BカートAPIのベースURL(契約に応じて設定)
BCART_API_BASE=https://api.bcart.jp
